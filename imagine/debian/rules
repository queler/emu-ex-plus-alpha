#!/usr/bin/make -f
export IMAGINE_PATH := $(CURDIR)
export IMAGINE_SDK_PATH := $(CURDIR)/imagine-sdk

%:
	dh $@

override_dh_auto_configure:
	rm -rf build/linux-x86_64
	cmake --preset linux-x86_64 \
		-DCMAKE_C_COMPILER=clang-21 \
		-DCMAKE_CXX_COMPILER=clang++-21 \
		-DCMAKE_CXX_FLAGS_INIT="-stdlib=libc++" \
		-DCMAKE_EXE_LINKER_FLAGS_INIT="-stdlib=libc++" \
		-DCMAKE_SHARED_LINKER_FLAGS_INIT="-stdlib=libc++" \
		-DCMAKE_CXX_STDLIB_MODULES_JSON=/usr/lib/llvm-21/lib/libc++.modules.json \
		-DCMAKE_AR=/usr/bin/llvm-ar-21 \
		-DCMAKE_RANLIB=/usr/bin/llvm-ranlib-21
		
override_dh_auto_build:
	cmake --build build/linux-x86_64 --config Release

override_dh_auto_install:
	mkdir -p debian/emu-ex-plus-alpha-imagine/usr/bin
	# install -m 755 build/linux-x86_64/path/to/binary debian/emu-ex-plus-alpha-imagine/usr/bin/ls